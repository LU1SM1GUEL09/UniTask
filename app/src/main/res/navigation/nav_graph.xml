<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.miguel.unitask.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.miguel.unitask.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action android:id="@+id/action_login_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.miguel.unitask.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action android:id="@+id/action_register_to_dashboard"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.miguel.unitask.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action android:id="@+id/action_dashboard_to_materias"
            app:destination="@id/materiasFragment" />
        <action android:id="@+id/action_dashboard_to_tareas"
            app:destination="@id/tareasFragment" />
        <action android:id="@+id/action_dashboard_to_examenes"
            app:destination="@id/examenesFragment" />
        <action android:id="@+id/action_dashboard_to_notas"
            app:destination="@id/notasFragment" />
        <action android:id="@+id/action_dashboard_to_horario"
            app:destination="@id/horarioFragment" />
        <action android:id="@+id/action_dashboard_to_perfil"
            app:destination="@id/perfilFragment" />
    </fragment>

    <fragment
        android:id="@+id/materiasFragment"
        android:name="com.miguel.unitask.MateriasFragment"
        android:label="Materias"
        tools:layout="@layout/fragment_materias">
        <action android:id="@+id/action_materias_to_detalle_mat"
            app:destination="@id/detalleMatFragment" />
    </fragment>

    <fragment
        android:id="@+id/tareasFragment"
        android:name="com.miguel.unitask.TareasFragment"
        android:label="Tareas"
        tools:layout="@layout/fragment_tareas" />

    <fragment
        android:id="@+id/examenesFragment"
        android:name="com.miguel.unitask.ExamenesFragment"
        android:label="Exámenes"
        tools:layout="@layout/fragment_examenes" />

    <fragment
        android:id="@+id/notasFragment"
        android:name="com.miguel.unitask.NotasFragment"
        android:label="Notas"
        tools:layout="@layout/fragment_notas" />

    <fragment
        android:id="@+id/horarioFragment"
        android:name="com.miguel.unitask.HorarioFragment"
        android:label="Horario"
        tools:layout="@layout/fragment_horario" />

    <fragment
        android:id="@+id/detalleMatFragment"
        android:name="com.miguel.unitask.DetalleMatFragment"
        android:label="Detalle Materia"
        tools:layout="@layout/fragment_detalle_mat">
        <argument
            android:name="materiaId"
            app:argType="string"
            app:nullable="false" />
    </fragment>

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.miguel.unitask.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />

</navigation>
